@using SixLabors.ImageSharp.Processing
@model OpenOrderSystem.Core.Areas.Staff.ViewModels.OrderTerminal.OrderTerminalVM

@{
    Layout = "_HtmlBaseLayout";
    ViewData["Title"] = Model.IsRegisteredTerminal 
        ? $"{Model.OrderTerminalName} Staff Terminal"
        : "Staff Terminal [Unregistered]";
    string[] stageColors =
    [
        "green",
        "blue",
        "orange",
        "purple",
        "red",
        "teal",
        "gold",
        "crimson",
        "slateblue",
        "coral",
    ];
    var rand = new Random();
}

@section AppendHead {
    <link href="~/css/staff-orderTerminal.css" rel="stylesheet" />
}

<main>
    <header>
        <section class="terminal-header">
            <div class="printer-tray">
                <span class="printer-state-icon"></span>
                <span class="printer-paper-icon"></span>
                <span class="printer-error-icon"></span>
            </div>
            <div class="terminal-info">
                <h1 class="branding-header">OOS Order Terminal</h1>
                <h2 class="branding-terminal-identity">@(Model.IsRegisteredTerminal ? Model.OrderTerminalName : "View Only Terminal")</h2>
                <small class="branding-menu-help">double tap to open menu</small>
            </div>
            <div class="terminal-clock">
                <div class="time">
                    <span class="H"></span>:<span class="M"></span> <span class="AP"></span>
                </div>
                <div class="date">
                    <span class="D1"></span>/<span class="D2"></span>/<span class="D3"></span>
                </div>
            </div>
        </section>
        <section class="queue"> ORDER QUEUE HERE</section>
    </header>
    <div class="order-stage-container">
        @for (var i = 0; i < Model.Stages.Count - 1; ++i)
         { 
             var stage = Model.Stages[i];
             var classname = stage.StageName.ToLower().Replace(' ', '-');
             <section class="orders-stage @(classname)" style="--stage-color: @(stageColors[rand.Next(stageColors.Length - 1)]);">
                 <h3 class="stage-name">@stage.StageName</h3>
                 <div class="card-deck">
                     @foreach (var order in stage.Orders)
                     {
                         <div class="card">
                             <h4 class="order-number">Order: #@order.OrderInfo.OrderId</h4>
                             <h5>@order.OrderInfo.CustomerName</h5>
                             <h5>@order.OrderInfo.CustomerPhone</h5>
                             <hr/>
                             <div class="order-line-container">
                                 @foreach (var line in order.OrderInfo.OrderLines)
                                 {
                                     <div class="order-line">
                                         <div class="order-line-item countable">@line.ItemName</div>
                                         @if (line.AddedOptionsList?.Any() ?? false)
                                         {
                                             <div class="order-line-additions countable">
                                                 <span class="action">Add:</span>
                                                 @string.Join(", ", line.AddedOptionsList.ToArray())
                                             </div>
                                         }
                                         @if (line.RemovedOptionsList?.Any() ?? false)
                                         {
                                             <div class="order-line-subtractions countable">
                                                 <span class="action">Remove:</span>
                                                 @string.Join(", ", line.RemovedOptionsList.ToArray())
                                             </div>
                                         }
                                     </div>
                                 }
                             </div>
                         </div>
                     }
                 </div>
             </section>
         }        
    </div>
    <footer class="complete">
        
    </footer>
</main>

@section Scripts
{
    <!--Clock update script-->
    <script>
        const dateFormat = { D1: 'M', D2: 'D', D3: 'Y' }; // swap values to reorder/reformat

        function pad(n) { return n.toString().padStart(2, '0'); }

        function updateClock() {
            const now = new Date();

            let h = now.getHours();
            const ap = h >= 12 ? 'PM' : 'AM';
            h = h % 12 || 12;

            document.querySelector('.H').textContent = h;
            document.querySelector('.M').textContent = pad(now.getMinutes());
            document.querySelector('.AP').textContent = ap;

            const parts = {
                M: pad(now.getMonth() + 1),
                D: pad(now.getDate()),
                Y: now.getFullYear(),
                YY: pad(now.getFullYear() % 100)
            };

            for (const [slot, key] of Object.entries(dateFormat)) {
                document.querySelector(`.${slot}`).textContent = parts[key];
            }
}

        updateClock();
        setInterval(updateClock, 1000);
    </script>
}
